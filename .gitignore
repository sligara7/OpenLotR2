# Windows thumbnail cache files
Thumbs.db
ehthumbs.db
ehthumbs_vista.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# =========================
# Operating System Files
# =========================
node_modules/*

dist/*
!dist/.gitkeep
release/*
!release/.gitkeep
doc/_build/*
static/docs/*
.vscode/

# Playwright / test + tooling artifacts
playwright-report/
test-results/
.playwright-mcp/
*.png
!doc/**/*.png

# Extracted ORIGINAL game data (copyrighted) — analysis only, never commit.
extracted/
*.pgm

# Copyrighted reference docs (local only)
doc/manual.pdf
*.pdf

# reflow2: the live graph store is a local RocksDB database — machine-local and
# binary. The design itself is committed as the deterministic export under
# .reflow2/backups/.
.reflow2/*
!.reflow2/backups/
